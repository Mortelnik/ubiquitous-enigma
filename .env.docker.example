# Docker Compose окружение.
# Скопируйте в .env.docker перед запуском:
#   cp .env.docker.example .env.docker

UPLOAD_DIR=/app/uploads
OBSIDIAN_VAULT=/app/obsidian_vault
OBSIDIAN_FOLDER=Встречи
REPORT_DIR=/app/reports

REDIS_URL=redis://redis:6379/0

# Для первого запуска в контейнере лучше начать с небольшой модели.
# После проверки можно заменить на medium/large-v3.
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# Стабильный Docker/MVP-режим: Whisper идёт на CPU/int8 даже если GPU виден.
# docker-compose.gpu.yml устанавливает нужные библиотеки и включает этот флаг.
WHISPER_CUDA_ENABLED=false
WHISPER_FALLBACK_TO_CPU=true
WHISPERX_FALLBACK_ENABLED=false
LANGUAGE=ru
# Необязательный токен Hugging Face; используется только для скачивания моделей.
HF_TOKEN=

# По умолчанию выключено для стабильного CPU-запуска в Docker.
# Для диаризации задайте UV_EXTRAS="audio diarization" и ENABLE_DIARIZATION=true.
UV_EXTRAS=audio
ENABLE_DIARIZATION=false
MAX_SPEAKERS=10
DIARIZATION_MODEL=nvidia/speakerverification_en_titanet_large
DIARIZATION_DEVICE=auto
DIARIZATION_FALLBACK_TO_CPU=true

OLLAMA_MODEL=qwen3.8:27b
OLLAMA_HOST=http://ollama:11434

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=

# Local trained classifier (read-only mount in Docker).
CLASSIFIER_MODEL=/app/models/style_classifier.joblib
MAX_UPLOAD_MB=100
# Web API key; the bot uses the separate VOICEFLOW_BOT_API_TOKEN below.
VOICEFLOW_API_TOKEN=

# Telegram is optional. Empty allowlist denies all users.
# true = вернуть стиль, метрики и фрагменты текста в Telegram.
BOT_SEND_RESULTS=false
BOT_DEFAULT_PROMPT=style_classifier
TELEGRAM_BOT_TOKEN=
BOT_ALLOWED_USER_IDS=
# Optional local VPN proxy; inside Docker use the Windows host address, not localhost.
# Example: http://host.docker.internal:7890 (replace the port with your VPN proxy port).
TELEGRAM_PROXY_URL=

VOICEFLOW_BOT_API_TOKEN=
QUEUE_MAX_JOBS=20
QUEUE_MAX_USER_JOBS=3
QUEUE_ADMISSION_INTERVAL_SEC=3
UPLOAD_TIMEOUT_SEC=180
QUEUE_TIMEOUT_SEC=3600
PROCESS_TIMEOUT_SEC=900
MAX_AUDIO_DURATION_SEC=600
FFMPEG_TIMEOUT_SEC=120
OLLAMA_TIMEOUT_SEC=180
JOB_HISTORY_SEC=86400
UPLOAD_RETENTION_HOURS=24
BOT_QUEUE_TIMEOUT_SEC=3700
BOT_TASK_TIMEOUT_SEC=900
BOT_POLL_INTERVAL_SEC=2
BOT_MAX_POLL_INTERVAL_SEC=15
BOT_DOWNLOAD_CONCURRENCY=2
BOT_COMMAND_INTERVAL_SEC=2
