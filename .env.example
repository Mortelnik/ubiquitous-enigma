# ─── Скопируйте в .env и при необходимости отредактируйте ─────────────────────
# Реальные секреты сюда НЕ коммитьте. .env уже в .gitignore.

# ─── Пути ──────────────────────────────────────────────────────────────────────
# Каталог для загруженных аудио (относительный путь — от корня проекта).
UPLOAD_DIR=uploads
# Путь к вашему Obsidian vault. Можно ~/, абсолютный или относительный.
OBSIDIAN_VAULT=obsidian_vault
# Подпапка внутри vault, куда складываются заметки.
OBSIDIAN_FOLDER=Встречи
# Каталог JSONL/CSV-метрик для отчёта по MVP.
REPORT_DIR=reports

# ─── Celery / Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Whisper ─────────────────────────────────────────────────────────────────────
# Модели faster-whisper: tiny / base / small / medium / large-v3
WHISPER_MODEL=base
# auto = CUDA при доступном CUDA CTranslate2 и включённом флаге, иначе CPU.
WHISPER_DEVICE=auto
# auto = float16 на CUDA, int8 на CPU. Можно явно: float16 / int8 / int8_float16 / float32.
WHISPER_COMPUTE_TYPE=auto
# Стабильный MVP-режим: не пробовать Faster-Whisper CUDA на Windows/RTX 50xx/cu130.
WHISPER_CUDA_ENABLED=false
# Если CUDA runtime для faster-whisper сломан, сначала пробуется WhisperX CUDA,
# затем при необходимости Faster-Whisper CPU/int8.
WHISPER_FALLBACK_TO_CPU=true
# На Windows + RTX 50xx + cu130 WhisperX может зависать. Для MVP по умолчанию
# пропускаем WhisperX и сразу уходим на Faster-Whisper CPU/int8.
WHISPERX_FALLBACK_ENABLED=false
LANGUAGE=ru
# Необязательный токен Hugging Face для скачивания моделей.
HF_TOKEN=

# ─── Диаризация ───────────────────────────────────────────────────────────────────
# false — пропускать тяжёлый этап NeMo (один спикер). Удобно без GPU.
ENABLE_DIARIZATION=false
MAX_SPEAKERS=10
DIARIZATION_MODEL=nvidia/speakerverification_en_titanet_large
# auto = CUDA при доступном CUDA PyTorch, иначе CPU. Можно явно: cuda или cpu.
DIARIZATION_DEVICE=auto
# Если NeMo CUDA падает из-за неподдерживаемой GPU-архитектуры, автоматически повторить на CPU.
DIARIZATION_FALLBACK_TO_CPU=true

# ─── Ollama (генерация саммари) ─────────────────────────────────────────────────
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# ─── API / CORS ──────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
# Дополнительные разрешённые origin'ы через запятую. Пусто — только same-origin.
CORS_ORIGINS=

# ─── Телеграм-бот (модуль bot/, запускается отдельно) ───────────────────────
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Базовый URL FastAPI VoiceFlow AI (для docker-compose: http://api:8000).
VOICEFLOW_API_URL=http://localhost:8000
# Промпт по умолчанию: style_classifier (классификация стиля речи) или prompt_1..5.
BOT_DEFAULT_PROMPT=style_classifier
# Интервал опроса статуса задачи, сек.
BOT_POLL_INTERVAL_SEC=2.0
# Максимальное время ожидания обработки, сек.
BOT_TASK_TIMEOUT_SEC=900
# Белый список user_id через запятую (пусто — бот не запустится).
BOT_ALLOWED_USER_IDS=
# Optional HTTP/SOCKS proxy for Telegram only; leave empty when direct access works.
TELEGRAM_PROXY_URL=

# Local trained classifier (read-only mount in Docker).
CLASSIFIER_MODEL=models/style_classifier.joblib
MAX_UPLOAD_MB=100
# Web API key; the bot uses the separate VOICEFLOW_BOT_API_TOKEN below.
VOICEFLOW_API_TOKEN=

# Telegram is optional. Empty allowlist denies all users.
BOT_SEND_RESULTS=false

VOICEFLOW_BOT_API_TOKEN=
QUEUE_MAX_JOBS=20
QUEUE_MAX_USER_JOBS=3
QUEUE_ADMISSION_INTERVAL_SEC=3
UPLOAD_TIMEOUT_SEC=180
QUEUE_TIMEOUT_SEC=3600
PROCESS_TIMEOUT_SEC=900
MAX_AUDIO_DURATION_SEC=600
FFMPEG_TIMEOUT_SEC=120
OLLAMA_TIMEOUT_SEC=180
JOB_HISTORY_SEC=86400
UPLOAD_RETENTION_HOURS=24
BOT_QUEUE_TIMEOUT_SEC=3700
BOT_MAX_POLL_INTERVAL_SEC=15
BOT_DOWNLOAD_CONCURRENCY=2
BOT_COMMAND_INTERVAL_SEC=2
